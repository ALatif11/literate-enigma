# Kalshi API credentials (get from https://kalshi.com/account/api-keys)
KALSHI_API_KEY_ID=your-api-key-id-here
# Path to your RSA private key file (PEM format), OR inline PEM string
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# API environment: demo or production
# demo  -> https://demo-api.kalshi.co/trade-api/v2
# prod  -> https://trading-api.kalshi.com/trade-api/v2
KALSHI_ENV=demo

# SQLite database file path
KALSHI_DB_PATH=./kalshi_backtest.db

# Backtester defaults
# Score threshold (0.0–1.0) below which markets are skipped
KALSHI_SCORE_THRESHOLD=0.4
# Trade strategy: 'underdog' buys the cheaper (<50¢) side; 'favorite' buys the more-likely side
KALSHI_STRATEGY=underdog
# Simulated stake per trade in cents (e.g. 100 = $1.00).
# Only used when KALSHI_BANKROLL_CENTS is 0 (fixed-stake mode).
KALSHI_STAKE_CENTS=100

# --- Kelly Criterion position sizing (optional) ---
# Set KALSHI_BANKROLL_CENTS > 0 to enable Kelly sizing.
# Each trade stake is then: bankroll × kelly_fraction × f*
#   where f* = (p_model × b − q) / b  (full Kelly fraction)
#
# Starting bankroll in cents (0 = disabled, use fixed stake above)
KALSHI_BANKROLL_CENTS=0
# Fraction of full Kelly to apply: 0.25 = quarter-Kelly (recommended),
# 0.5 = half-Kelly, 1.0 = full Kelly (volatile, not recommended).
KALSHI_KELLY_FRACTION=0.25

# --- Web command center (kalshi-bt serve) ---
# Anthropic API key for Claude AI market analysis (proxied server-side)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
